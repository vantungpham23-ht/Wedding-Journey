# Cloudflare Pages — HTTP headers
#
# ⚠ VÌ SAO CẦN FILE NÀY?
# Mặc định Cloudflare Pages trả về:
#     cache-control: public, max-age=0, must-revalidate
#     cf-cache-status: DYNAMIC
#
# → Mỗi lần mở web, Cloudflare phải hỏi origin (revalidate) cho TỪNG
#   file .glb / .wasm / .mp3. Không có edge cache → người dùng thứ 2
#   trở đi vẫn phải chờ server trả về toàn bộ 15MB model.
#
# File này ép Cloudflare cache 1 NĂM cho asset tĩnh (tên file có hash
# / không đổi → cache vĩnh viễn an toàn).
#
# 📖 Docs: https://developers.cloudflare.com/pages/configuration/headers/

# ─────────────────────────────────────────────────────────────
# ASSET 3D — model GLB (15MB tổng)
# ─────────────────────────────────────────────────────────────
/models/*
  Cache-Control: public, max-age=31536000, immutable

# ─────────────────────────────────────────────────────────────
# DRACO DECODER — WASM + JS (~1MB)
# ─────────────────────────────────────────────────────────────
/draco/*
  Cache-Control: public, max-age=31536000, immutable

# ─────────────────────────────────────────────────────────────
# NHẠC NỀN — MP3 (3MB)
# ─────────────────────────────────────────────────────────────
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# ─────────────────────────────────────────────────────────────
# NEXT.JS ASSETS — JS/CSS đã có hash trong tên → cache vĩnh viễn
# ─────────────────────────────────────────────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# ─────────────────────────────────────────────────────────────
# HTML — KHÔNG cache (để deploy mới nhận được ngay)
# ─────────────────────────────────────────────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# ─────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Cho phép tải GLB/WASM từ domain khác (nếu sau này embed vào
# Facebook/Instagram preview hoặc dùng chung CDN).
/models/*
  Access-Control-Allow-Origin: *
/draco/*
  Access-Control-Allow-Origin: *
